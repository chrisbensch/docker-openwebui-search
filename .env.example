# For a fresh deployment, copy this file to .env, fill in the OmniRoute
# settings below, and run ./setup.sh. Keep .env private.

# Use the OpenAI-compatible base URL reachable from the Open WebUI container.
OMNIROUTE_BASE_URL=https://omniroute.example.com/v1
OMNIROUTE_API_KEY=

# Optional Compose project name. setup.sh defaults to open-webui-search.
# COMPOSE_PROJECT_NAME=open-webui-search

# Leave these commented so setup.sh generates unique secrets in .env.
# WEBUI_SECRET_KEY=
# SEARXNG_SECRET=
# FIRECRAWL_POSTGRES_PASSWORD=
# FIRECRAWL_BULL_AUTH_KEY=
